CXX14 = /usr/bin/g++
CXX17 = /usr/bin/g++
CXX20 = /usr/bin/g++
CXX20STD = -std=c++20
CC17 = /usr/bin/gcc
CC90 = /usr/bin/gcc
CC99 = /usr/bin/gcc
